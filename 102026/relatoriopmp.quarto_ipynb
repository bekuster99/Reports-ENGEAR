{
  "cells": [
    {
      "cell_type": "raw",
      "metadata": {},
      "source": [
        "---\n",
        "title: \"Análise de PMP\"\n",
        "subtitle: \"DRE Mensal, Acumulado Anual e Segmentações Estratégicas\"\n",
        "format:\n",
        "  html:\n",
        "    page-layout: full\n",
        "    theme: cosmo\n",
        "    toc: false\n",
        "    css: styles.css\n",
        "    embed-resources: true\n",
        "---"
      ],
      "id": "e4d7d814"
    },
    {
      "cell_type": "code",
      "metadata": {
        "message": false
      },
      "source": [
        "#| echo: false\n",
        "#| warning: false\n",
        "#| output: asis\n",
        "\n",
        "import json\n",
        "import pandas as pd\n",
        "from IPython.display import display, HTML\n",
        "from plotly.offline import get_plotlyjs\n",
        "\n",
        "# =========================================================================\n",
        "# 1. PARÂMETROS (edite aqui, no código)\n",
        "# =========================================================================\n",
        "ARQUIVO = \"DRGCP.xlsx\"\n",
        "ANO_PADRAO = 2026\n",
        "MES_PADRAO = 9\n",
        "\n",
        "# Coluna que define o mês de cada lançamento (emissão = competencia)\n",
        "COLUNA_REFERENCIA = \"competencia\"\n",
        "COLUNA_PAGAMENTO = \"pagamento\"\n",
        "\n",
        "# Códigos de classificação fora do cálculo do PMP\n",
        "# A = receitas | B = impostos s/ receita | C1 = folha | D1 = folha\n",
        "# D4 = intercompany | E = depreciação | F = financeiras | O = impostos s/ lucro\n",
        "CODIGOS_EXCLUIDOS = {\"A\", \"B\", \"C1\", \"D1\", \"D4\", \"E\", \"F\", \"O\"}\n",
        "\n",
        "# =========================================================================\n",
        "# 2. CARGA E PREPARO\n",
        "# =========================================================================\n",
        "hoje = pd.Timestamp.today().normalize()\n",
        "\n",
        "df = pd.read_excel(ARQUIVO)\n",
        "df[COLUNA_REFERENCIA] = pd.to_datetime(df[COLUNA_REFERENCIA], errors=\"coerce\")\n",
        "df[COLUNA_PAGAMENTO] = pd.to_datetime(df[COLUNA_PAGAMENTO], errors=\"coerce\")\n",
        "df[\"valor_original\"] = pd.to_numeric(df[\"valor_original\"], errors=\"coerce\").fillna(0)\n",
        "\n",
        "for col in [\"centro_de_custo\", \"empresa\"]:\n",
        "    df[col] = df[col].fillna(\"\").astype(str).str.strip().replace(\"\", \"(vazio)\")\n",
        "\n",
        "df[\"codigo_classe\"] = (\n",
        "    df[\"classificacao_competencia\"].astype(str).str.split(\" - \").str[0].str.strip()\n",
        ")\n",
        "\n",
        "# Quantos positivos foram removidos (para a nota)\n",
        "mascara_fora = df[\"codigo_classe\"].isin(CODIGOS_EXCLUIDOS)\n",
        "n_positivos_removidos = int(((~mascara_fora) & (df[\"valor_original\"] > 0)).sum())\n",
        "\n",
        "# Base do PMP: apenas despesas (valor negativo) fora das classes excluídas\n",
        "base = df[~mascara_fora & (df[\"valor_original\"] < 0)].copy()\n",
        "base = base.dropna(subset=[COLUNA_REFERENCIA, COLUNA_PAGAMENTO]).copy()\n",
        "\n",
        "base[\"Dias\"] = (base[COLUNA_PAGAMENTO] - base[COLUNA_REFERENCIA]).dt.days\n",
        "# Peso = valor original. Como todos são negativos, a razão soma(v×d)/soma(v) fica positiva\n",
        "base[\"Peso\"] = base[\"valor_original\"]\n",
        "base[\"Peso_x_Dias\"] = base[\"Peso\"] * base[\"Dias\"]\n",
        "base[\"Mes\"] = base[COLUNA_REFERENCIA].dt.to_period(\"M\").dt.strftime(\"%Y-%m\")\n",
        "\n",
        "n_lancamentos = len(base)\n",
        "n_futuros = int((base[COLUNA_PAGAMENTO] > hoje).sum())\n",
        "n_dias_negativos = int((base[\"Dias\"] < 0).sum())\n",
        "\n",
        "# Agregação para recálculo exato no navegador (PMP ponderado e simples)\n",
        "agg = (\n",
        "    base.groupby([\"empresa\", \"centro_de_custo\", \"Mes\"], as_index=False)\n",
        "    .agg(\n",
        "        soma_peso=(\"Peso\", \"sum\"),\n",
        "        soma_peso_dias=(\"Peso_x_Dias\", \"sum\"),\n",
        "        soma_dias=(\"Dias\", \"sum\"),\n",
        "        qtd=(\"Dias\", \"size\"),\n",
        "    )\n",
        "    .rename(columns={\"empresa\": \"empresa\", \"centro_de_custo\": \"centro\"})\n",
        ")\n",
        "\n",
        "dados_json = json.dumps(agg.to_dict(orient=\"records\"), ensure_ascii=False, default=float)\n",
        "centros_json = json.dumps(sorted(agg[\"centro\"].unique().tolist()), ensure_ascii=False)\n",
        "anos_json = json.dumps(sorted({m[:4] for m in agg[\"Mes\"]}))\n",
        "plotly_js = get_plotlyjs()\n",
        "\n",
        "# =========================================================================\n",
        "# 3. NOTAS DE METODOLOGIA\n",
        "# =========================================================================\n",
        "notas_html = f\"\"\"\n",
        "<div style=\"font-size:12px; color:#475569; background:#F8FAFC; border-left:3px solid #CBD5E1; padding:10px 14px; line-height:1.6; margin-bottom:10px;\">\n",
        "  <b>Notas de metodologia</b>\n",
        "  <ol style=\"margin:6px 0 0 18px; padding:0;\">\n",
        "    <li><b>Folha salarial excluída:</b> C1 - Custo Pessoal e D1 - Despesas Pessoal Adm não entram em nenhum PMP desta página.</li>\n",
        "    <li><b>Classes excluídas:</b> A (receitas), B (impostos sobre receita e deduções), E (depreciação e amortização), F (receitas e despesas financeiras), D4 (intercompany) e O (impostos sobre lucro). Essas classes não representam pagamento a fornecedor e distorceriam o prazo.</li>\n",
        "    <li><b>Mês de referência:</b> data de emissão (competência), definida em COLUNA_REFERENCIA no código.</li>\n",
        "    <li><b>Valores positivos removidos:</b> {n_positivos_removidos:,} lançamentos com valor positivo foram retirados. Entram apenas despesas (valor negativo), com peso igual ao valor original.</li>\n",
        "    <li><b>Pagamentos futuros considerados:</b> {n_futuros:,} dos {n_lancamentos:,} lançamentos têm data de pagamento posterior a {hoje.strftime('%d/%m/%Y')}. Eles entram no cálculo como pagamento previsto.</li>\n",
        "    <li><b>Dias negativos:</b> {n_dias_negativos:,} lançamentos têm pagamento anterior à emissão e entram no cálculo como dias negativos.</li>\n",
        "    <li><b>Centro de custo ou empresa em branco:</b> aparecem como (vazio) na lista de seleção.</li>\n",
        "    <li><b>Empresas:</b> o PMP Geral inclui ENGEAR SL, ENGEAR MNT e INTEGRA.</li>\n",
        "    <li><b>Fórmulas:</b> PMP ponderado = soma(valor × dias) ÷ soma(valor). PMP simples = média aritmética dos dias por lançamento, sem peso.</li>\n",
        "    <li><b>Leitura:</b> no PMP de pagamento, aumento de dias significa pagar mais tarde, o que é favorável ao caixa. Por isso, a variação aparece em cor neutra.</li>\n",
        "  </ol>\n",
        "</div>\n",
        "\"\"\"\n",
        "\n",
        "# =========================================================================\n",
        "# 4. HTML + JAVASCRIPT\n",
        "# =========================================================================\n",
        "template = \"\"\"\n",
        "<script>__PLOTLY__</script>\n",
        "<div style=\"font-family: 'Segoe UI', Arial;\">\n",
        "\n",
        "  <div style=\"display:flex; gap:24px; flex-wrap:wrap; align-items:flex-start; margin-bottom:12px;\">\n",
        "    <label style=\"font-size:13px;\">Mês<br>\n",
        "      <select id=\"sel-mes\" style=\"padding:6px; min-width:110px;\"></select></label>\n",
        "    <label style=\"font-size:13px;\">Ano<br>\n",
        "      <select id=\"sel-ano\" style=\"padding:6px; min-width:110px;\"></select></label>\n",
        "    <label style=\"font-size:13px;\">Centros de custo<br>\n",
        "      <select id=\"sel-centro\" multiple size=\"6\" style=\"padding:6px; min-width:420px;\"></select></label>\n",
        "  </div>\n",
        "  <p style=\"font-size:12px; color:#64748B; margin-top:0;\">\n",
        "    Ctrl + clique para marcar vários centros. Sem nenhum marcado, o relatório considera todos.\n",
        "  </p>\n",
        "\n",
        "  __NOTAS__\n",
        "\n",
        "  <h3 class=\"mascara-titulo\" style=\"margin-top:30px;\">PMP Geral</h3>\n",
        "  <div id=\"kpi-geral\"></div>\n",
        "  <div id=\"grafico-geral\"></div>\n",
        "\n",
        "  <h3 class=\"mascara-titulo\" style=\"margin-top:40px;\">PMP · ENGEAR SL</h3>\n",
        "  <div id=\"kpi-sl\"></div>\n",
        "  <div id=\"grafico-sl\"></div>\n",
        "\n",
        "  <h3 class=\"mascara-titulo\" style=\"margin-top:40px;\">PMP · ENGEAR MNT</h3>\n",
        "  <div id=\"kpi-mnt\"></div>\n",
        "  <div id=\"grafico-mnt\"></div>\n",
        "</div>\n",
        "\n",
        "<script>\n",
        "const DADOS = __DADOS__;\n",
        "const CENTROS = __CENTROS__;\n",
        "const ANOS = __ANOS__;\n",
        "const MES_PAD = __MES_PAD__;\n",
        "const ANO_PAD = __ANO_PAD__;\n",
        "const NOMES_MES = [\"Jan\",\"Fev\",\"Mar\",\"Abr\",\"Mai\",\"Jun\",\"Jul\",\"Ago\",\"Set\",\"Out\",\"Nov\",\"Dez\"];\n",
        "const BLOCOS = [\n",
        "  {id: \"geral\", titulo: \"PMP Geral\", empresa: null},\n",
        "  {id: \"sl\",    titulo: \"PMP · ENGEAR SL\", empresa: \"ENGEAR SL\"},\n",
        "  {id: \"mnt\",   titulo: \"PMP · ENGEAR MNT\", empresa: \"ENGEAR MNT\"}\n",
        "];\n",
        "\n",
        "const selMes = document.getElementById(\"sel-mes\");\n",
        "const selAno = document.getElementById(\"sel-ano\");\n",
        "const selCentro = document.getElementById(\"sel-centro\");\n",
        "\n",
        "NOMES_MES.forEach((n, i) => selMes.add(new Option(n, String(i + 1).padStart(2, \"0\"), false, i + 1 === MES_PAD)));\n",
        "ANOS.forEach(a => selAno.add(new Option(a, a, false, Number(a) === ANO_PAD)));\n",
        "CENTROS.forEach(c => selCentro.add(new Option(c, c)));\n",
        "\n",
        "function addMeses(key, k) {\n",
        "  const [a, m] = key.split(\"-\").map(Number);\n",
        "  const t = a * 12 + (m - 1) + k;\n",
        "  return Math.floor(t / 12) + \"-\" + String((t % 12) + 1).padStart(2, \"0\");\n",
        "}\n",
        "function janela(key, n) {\n",
        "  const out = [];\n",
        "  for (let i = n - 1; i >= 0; i--) out.push(addMeses(key, -i));\n",
        "  return out;\n",
        "}\n",
        "function chaveAtual() { return selAno.value + \"-\" + selMes.value; }\n",
        "function centrosSel() { return Array.from(selCentro.selectedOptions).map(o => o.value); }\n",
        "function rotulo(k) { return NOMES_MES[Number(k.slice(5, 7)) - 1] + \"/\" + k.slice(0, 4); }\n",
        "\n",
        "function metricas(meses, empresa, centros) {\n",
        "  const set = new Set(meses);\n",
        "  let sp = 0, sw = 0, sd = 0, n = 0;\n",
        "  for (const r of DADOS) {\n",
        "    if (!set.has(r.Mes)) continue;\n",
        "    if (empresa && r.empresa !== empresa) continue;\n",
        "    if (centros.length && !centros.includes(r.centro)) continue;\n",
        "    sp += r.soma_peso_dias;\n",
        "    sw += r.soma_peso;\n",
        "    sd += r.soma_dias;\n",
        "    n  += r.qtd;\n",
        "  }\n",
        "  return {\n",
        "    pond: sw !== 0 ? sp / sw : null,\n",
        "    simp: n > 0 ? sd / n : null\n",
        "  };\n",
        "}\n",
        "\n",
        "const fmtDias = v => v === null ? \"sem base\" : v.toFixed(1).replace(\".\", \",\") + \" dias\";\n",
        "const fmtNum = v => v === null ? \"\" : v.toFixed(1).replace(\".\", \",\");\n",
        "const fmtVar = v => v === null ? \"sem base\" :\n",
        "  (v >= 0 ? \"+\" : \"\") + v.toFixed(1).replace(\".\", \",\") + \" dias\";\n",
        "\n",
        "function cardHtml(label, valor, sub) {\n",
        "  return `<div class=\"kpi-card\" style=\"background:#F8FAFC; padding:15px; border-radius:8px; border:1px solid #E2E8F0;\">\n",
        "    <div class=\"kpi-label\" style=\"font-size:11px; color:#64748B;\">${label}</div>\n",
        "    <div class=\"kpi-value\" style=\"font-size:18px; font-weight:bold; color:#0F172A;\">${valor}</div>\n",
        "    <div style=\"font-size:11px; color:#64748B; margin-top:4px;\">${sub}</div>\n",
        "  </div>`;\n",
        "}\n",
        "\n",
        "function renderBloco(b) {\n",
        "  const key = chaveAtual();\n",
        "  const c = centrosSel();\n",
        "  const mes = metricas([key], b.empresa, c);\n",
        "  const ano = metricas(janela(key, Number(key.slice(5, 7))), b.empresa, c);\n",
        "  const ant = metricas([addMeses(key, -12)], b.empresa, c);\n",
        "  const varPond = (mes.pond !== null && ant.pond !== null) ? mes.pond - ant.pond : null;\n",
        "  const varSimp = (mes.simp !== null && ant.simp !== null) ? mes.simp - ant.simp : null;\n",
        "\n",
        "  document.getElementById(\"kpi-\" + b.id).innerHTML = `\n",
        "    <div class=\"kpi-grid\" style=\"display:grid; grid-template-columns:repeat(3,1fr); gap:15px; margin:20px 0 25px;\">\n",
        "      ${cardHtml(\"PMP do Mês (\" + rotulo(key) + \") · ponderado\", fmtDias(mes.pond), \"Simples: \" + fmtDias(mes.simp))}\n",
        "      ${cardHtml(\"PMP do Ano (Jan até \" + rotulo(key) + \") · ponderado\", fmtDias(ano.pond), \"Simples: \" + fmtDias(ano.simp))}\n",
        "      ${cardHtml(\"Variação vs. mesmo mês do ano anterior · ponderado\", fmtVar(varPond), \"Simples: \" + fmtVar(varSimp))}\n",
        "    </div>`;\n",
        "\n",
        "  const serie = janela(key, 13);\n",
        "  const pond = serie.map(m => metricas([m], b.empresa, c).pond);\n",
        "  const simp = serie.map(m => metricas([m], b.empresa, c).simp);\n",
        "  const x = serie.map(rotulo);\n",
        "\n",
        "  Plotly.react(\"grafico-\" + b.id, [\n",
        "    {\n",
        "      type: \"bar\",\n",
        "      name: \"PMP ponderado\",\n",
        "      x: x,\n",
        "      y: pond,\n",
        "      text: pond.map(fmtNum),\n",
        "      textposition: \"outside\",\n",
        "      marker: { color: \"#C0392B\" },\n",
        "      hovertemplate: \"<b>Ponderado</b><br>%{x}: %{y:.1f} dias<extra></extra>\"\n",
        "    },\n",
        "    {\n",
        "      type: \"bar\",\n",
        "      name: \"PMP simples\",\n",
        "      x: x,\n",
        "      y: simp,\n",
        "      text: simp.map(fmtNum),\n",
        "      textposition: \"outside\",\n",
        "      marker: { color: \"#F5B7B1\" },\n",
        "      hovertemplate: \"<b>Simples</b><br>%{x}: %{y:.1f} dias<extra></extra>\"\n",
        "    }\n",
        "  ], {\n",
        "    title: { text: b.titulo + \" · Últimos 13 meses\", font: { size: 14 } },\n",
        "    barmode: \"group\",\n",
        "    yaxis: { title: \"Dias\" },\n",
        "    xaxis: { title: null },\n",
        "    legend: { orientation: \"h\", yanchor: \"bottom\", y: 1.02, xanchor: \"right\", x: 1 },\n",
        "    template: \"plotly_white\",\n",
        "    font: { family: \"Segoe UI, Arial\", size: 12, color: \"#1E293B\" },\n",
        "    margin: { t: 60, b: 30 },\n",
        "    height: 400,\n",
        "    plot_bgcolor: \"white\"\n",
        "  }, { responsive: true, displayModeBar: false });\n",
        "}\n",
        "\n",
        "function renderTudo() { BLOCOS.forEach(renderBloco); }\n",
        "[selMes, selAno, selCentro].forEach(el => el.addEventListener(\"change\", renderTudo));\n",
        "renderTudo();\n",
        "</script>\n",
        "\"\"\"\n",
        "\n",
        "html = (\n",
        "    template.replace(\"__PLOTLY__\", plotly_js)\n",
        "    .replace(\"__NOTAS__\", notas_html)\n",
        "    .replace(\"__DADOS__\", dados_json)\n",
        "    .replace(\"__CENTROS__\", centros_json)\n",
        "    .replace(\"__ANOS__\", anos_json)\n",
        "    .replace(\"__MES_PAD__\", str(MES_PADRAO))\n",
        "    .replace(\"__ANO_PAD__\", str(ANO_PADRAO))\n",
        ")\n",
        "\n",
        "display(HTML(html))"
      ],
      "id": "f79a302a",
      "execution_count": null,
      "outputs": []
    }
  ],
