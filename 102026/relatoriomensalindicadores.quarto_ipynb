      "metadata": {},
      "source": [
        "---\n",
        "title: \"Painel de Indicadores Financeiros\"\n",
        "subtitle: \"Análise Consolidada de Margens e Resultados\"\n",
        "jupyter: python3\n",
        "format:\n",
        "  html:\n",
        "    page-layout: full\n",
        "    theme: cosmo\n",
        "    toc: false\n",
        "    css: styles.css\n",
        "    embed-resources: true\n",
        "---"
      ],
      "id": "d2c62ff8"
    },
    {
      "cell_type": "code",
      "metadata": {
        "message": false
      },
      "source": [
        "#| echo: false\n",
        "#| warning: false\n",
        "\n",
        "import pandas as pd\n",
        "import plotly.graph_objects as go\n",
        "from plotly.subplots import make_subplots\n",
        "from IPython.display import display, HTML\n",
        "\n",
        "# -------------------------------------------------------------------------\n",
        "# 1. PARÂMETROS E CARREGAMENTO\n",
        "# -------------------------------------------------------------------------\n",
        "ANO_ANALISE = 2026\n",
        "MES_ANALISE = 10\n",
        "\n",
        "data_corte = pd.Timestamp(year=ANO_ANALISE, month=MES_ANALISE, day=1)\n",
        "inicio_13m = data_corte - pd.DateOffset(months=12)\n",
        "\n",
        "df = pd.read_excel(\"drgcc.xlsx\")\n",
        "df[\"Competência\"] = pd.to_datetime(df[\"Competência\"])\n",
        "df[\"Valor\"] = pd.to_numeric(df[\"Valor\"], errors=\"coerce\").fillna(0)\n",
        "df[\"Mes_Competencia\"] = df[\"Competência\"].dt.to_period(\"M\").dt.to_timestamp()\n",
        "\n",
        "# Limpeza e Padronização da coluna da Categoria (Garante apenas a letra maiúscula)\n",
        "df[\"Cat_Letra\"] = df[\"Categoria DRG CP\"].astype(str).str.strip().str[0].str.upper()\n",
        "\n",
        "# Funções de Formatação\n",
        "def fmt_r0(v):\n",
        "    return f\"R$ {v:,.0f}\".replace(\",\", \".\")\n",
        "\n",
        "def fmt_pct(v):\n",
        "    if pd.isna(v) or v == 0:\n",
        "        return \"0,0%\"\n",
        "    sinal = \"+\" if v >= 0 else \"\"\n",
        "    return f\"{sinal}{v:,.1f}%\".replace(\".\", \",\")\n",
        "\n",
        "# -------------------------------------------------------------------------\n",
        "# 2. CONSTRUÇÃO DA MATRIZ MENSAL DAS CATEGORIAS\n",
        "# -------------------------------------------------------------------------\n",
        "# Pivot table: Mes_Competencia x Cat_Letra (Valores em absoluto para cálculo de margem)\n",
        "df_cat_mes = (\n",
        "    df.groupby([\"Mes_Competencia\", \"Cat_Letra\"])[\"Valor\"]\n",
        "    .sum()\n",
        "    .unstack(fill_value=0)\n",
        ")\n",
        "# Garantir presença de todas as colunas necessárias no DataFrame\n",
        "for col in [\"A\", \"B\", \"C\", \"D\", \"E\", \"F\", \"O\"]:\n",
        "    if col not in df_cat_mes.columns:\n",
        "        df_cat_mes[col] = 0.0\n",
        "        # Normaliza sinais: tudo vira positivo para usar na subtração\n",
        "# (seus valores de saída já chegam negativos do Excel)\n",
        "df_cat_mes[\"A\"] = df_cat_mes[\"A\"].abs()\n",
        "df_cat_mes[[\"B\",\"C\",\"D\",\"E\",\"F\",\"O\"]] = df_cat_mes[[\"B\",\"C\",\"D\",\"E\",\"F\",\"O\"]].abs()\n",
        "\n",
        "# Cálculo dos Indicadores Estruturados por Mês\n",
        "df_ind = pd.DataFrame(index=df_cat_mes.index)\n",
        "\n",
        "df_ind[\"Receita Liquida\"]        = df_cat_mes[\"A\"] - df_cat_mes[\"B\"]\n",
        "df_ind[\"Margem de Contribuição\"] = df_cat_mes[\"A\"] - df_cat_mes[\"B\"] - df_cat_mes[\"C\"]\n",
        "df_ind[\"EBITDA\"]                 = df_cat_mes[\"A\"] - df_cat_mes[\"B\"] - df_cat_mes[\"C\"] - df_cat_mes[\"D\"]\n",
        "df_ind[\"EBITD\"]                  = df_cat_mes[\"A\"] - df_cat_mes[\"B\"] - df_cat_mes[\"C\"] - df_cat_mes[\"D\"] - df_cat_mes[\"E\"]\n",
        "df_ind[\"Lucro Liquido\"]          = df_cat_mes[\"A\"] - df_cat_mes[\"B\"] - df_cat_mes[\"C\"] - df_cat_mes[\"D\"] - df_cat_mes[\"E\"] + df_cat_mes[\"F\"] - df_cat_mes[\"O\"]\n",
        "\n",
        "# Receita Bruta (A) usada como denominador para Análise Vertical\n",
        "rec_bruta_mensal = df_cat_mes[\"A\"]\n",
        "\n",
        "# -------------------------------------------------------------------------\n",
        "# 3. GENERATION LOOP: GRÁFICOS COMBINADOS + CARDS DE KPIS\n",
        "# -------------------------------------------------------------------------\n",
        "indicadores_config = [\n",
        "    (\"Receita Líquida\", \"Receita Liquida\", \"#1E3A8A\"),\n",
        "    (\"Margem de Contribuição\", \"Margem de Contribuição\", \"#047857\"),\n",
        "    (\"EBITDA\", \"EBITDA\", \"#0284C7\"),\n",
        "    (\"EBITD\", \"EBITD\", \"#7C3AED\"),\n",
        "    (\"Lucro Líquido\", \"Lucro Liquido\", \"#B91C1C\")\n",
        "]\n",
        "\n",
        "for titulo_exibicao, col_df, cor_base in indicadores_config:\n",
        "    \n",
        "    # Bloco A: Filtragem 13 Meses para o Gráfico Misto\n",
        "    df_chart = df_ind[(df_ind.index >= inicio_13m) & (df_ind.index <= data_corte)].copy()\n",
        "    rec_chart = rec_bruta_mensal[(rec_bruta_mensal.index >= inicio_13m) & (rec_bruta_mensal.index <= data_corte)]\n",
        "    \n",
        "    labels_13m = df_chart.index.strftime(\"%b/%Y\")\n",
        "    valores_13m = df_chart[col_df]\n",
        "    av_13m = (valores_13m / rec_chart * 100).fillna(0)\n",
        "    \n",
        "    # Montagem do Gráfico com 2 Eixos Y (Eixo 1: R$ Colunas | Eixo 2: % Linha)\n",
        "    fig = make_subplots(specs=[[{\"secondary_y\": True}]])\n",
        "\n",
        "    # Colunas: Valor Monetário\n",
        "    fig.add_trace(\n",
        "        go.Bar(\n",
        "            x=labels_13m,\n",
        "            y=valores_13m,\n",
        "            name=\"Valor (R$)\",\n",
        "            text=[fmt_r0(v) for v in valores_13m],\n",
        "            textposition=\"outside\",\n",
        "            textfont=dict(family=\"Segoe UI, Arial\", size=10, color=\"#1E293B\"),\n",
        "            marker_color=cor_base,\n",
        "            hovertemplate=\"<b>%{x}</b><br>Valor: R$ %{y:,.2f}<extra></extra>\"\n",
        "        ),\n",
        "        secondary_y=False\n",
        "    )\n",
        "\n",
        "    # Linha: Análise Vertical (% Receita)\n",
        "    fig.add_trace(\n",
        "        go.Scatter(\n",
        "            x=labels_13m,\n",
        "            y=av_13m,\n",
        "            name=\"AV (% Rec.)\",\n",
        "            mode=\"lines+markers+text\",\n",
        "            text=[f\"{v:.1f}%\" for v in av_13m],\n",
        "            textposition=\"top center\",\n",
        "            textfont=dict(family=\"Segoe UI, Arial\", size=10, color=\"#D97706\"),\n",
        "            line=dict(color=\"#D97706\", width=2.5),\n",
        "            marker=dict(size=6, color=\"#B45309\"),\n",
        "            hovertemplate=\"<b>Análise Vertical</b><br>%{x}: %{y:.2f}%<extra></extra>\"\n",
        "        ),\n",
        "        secondary_y=True\n",
        "    )\n",
        "\n",
        "    fig.update_layout(\n",
        "        title=dict(text=f\"<b>{titulo_exibicao}</b> · Evolução Mensal e AV %\", font=dict(size=16, color=\"#0F172A\")),\n",
        "        template=\"plotly_white\",\n",
        "        showlegend=False,\n",
        "        font=dict(family=\"Segoe UI, Arial\", size=11, color=\"#1E293B\"),\n",
        "        margin=dict(t=50, b=20),\n",
        "        height=380,\n",
        "        plot_bgcolor=\"white\"\n",
        "    )\n",
        "\n",
        "    fig.update_yaxes(title_text=\"Valor (R$)\", secondary_y=False, showgrid=True, gridcolor=\"#F1F5F9\")\n",
        "    fig.update_yaxes(title_text=\"Análise Vertical (%)\", secondary_y=True, showgrid=False)\n",
        "\n",
        "    # Bloco B: Cálculos Anuais para os Cards\n",
        "    val_ano_atual = df_ind[df_ind.index.year == ANO_ANALISE][col_df].sum()\n",
        "    rec_ano_atual = rec_bruta_mensal[rec_bruta_mensal.index.year == ANO_ANALISE].sum()\n",
        "    pct_ano_atual = (val_ano_atual / rec_ano_atual * 100) if rec_ano_atual > 0 else 0\n",
        "\n",
        "    val_ano_ant = df_ind[df_ind.index.year == (ANO_ANALISE - 1)][col_df].sum()\n",
        "    rec_ano_ant = rec_bruta_mensal[rec_bruta_mensal.index.year == (ANO_ANALISE - 1)].sum()\n",
        "    pct_ano_ant = (val_ano_ant / rec_ano_ant * 100) if rec_ano_ant > 0 else 0\n",
        "\n",
        "    media_ano_atual = df_ind[df_ind.index.year == ANO_ANALISE][col_df].mean()\n",
        "\n",
        "    # Bloco C: Renderização em Tela\n",
        "    display(HTML(f'<div style=\"margin-top: 40px; border-top: 2px solid #E2E8F0; padding-top: 20px;\"></div>'))\n",
        "    fig.show()\n",
        "\n",
        "    cards_html = f\"\"\"\n",
        "    <div style=\"display: grid; grid-template-columns: repeat(5, 1fr); gap: 15px; margin-top: 10px; margin-bottom: 40px;\">\n",
        "      <div style=\"background: #F8FAFC; padding: 15px; border-radius: 8px; border: 1px solid #E2E8F0;\">\n",
        "        <div style=\"font-size: 11px; color: #64748B; font-weight: 600;\">Valor no Ano ({ANO_ANALISE})</div>\n",
        "        <div style=\"font-size: 18px; font-weight: bold; color: #0F172A; margin-top: 4px;\">{fmt_r0(val_ano_atual)}</div>\n",
        "      </div>\n",
        "      <div style=\"background: #F8FAFC; padding: 15px; border-radius: 8px; border: 1px solid #E2E8F0;\">\n",
        "        <div style=\"font-size: 11px; color: #64748B; font-weight: 600;\">% no Ano (AV Rec.)</div>\n",
        "        <div style=\"font-size: 18px; font-weight: bold; color: #0F172A; margin-top: 4px;\">{pct_ano_atual:.1f}%</div>\n",
        "      </div>\n",
        "      <div style=\"background: #F8FAFC; padding: 15px; border-radius: 8px; border: 1px solid #E2E8F0;\">\n",
        "        <div style=\"font-size: 11px; color: #64748B; font-weight: 600;\">Valor Ano Anterior ({ANO_ANALISE - 1})</div>\n",
        "        <div style=\"font-size: 18px; font-weight: bold; color: #0F172A; margin-top: 4px;\">{fmt_r0(val_ano_ant)}</div>\n",
        "      </div>\n",
        "      <div style=\"background: #F8FAFC; padding: 15px; border-radius: 8px; border: 1px solid #E2E8F0;\">\n",
        "        <div style=\"font-size: 11px; color: #64748B; font-weight: 600;\">% Anterior (AV Rec.)</div>\n",
        "        <div style=\"font-size: 18px; font-weight: bold; color: #0F172A; margin-top: 4px;\">{pct_ano_ant:.1f}%</div>\n",
        "      </div>\n",
        "      <div style=\"background: #F8FAFC; padding: 15px; border-radius: 8px; border: 1px solid #E2E8F0;\">\n",
        "        <div style=\"font-size: 11px; color: #64748B; font-weight: 600;\">Média Mensal ({ANO_ANALISE})</div>\n",
        "        <div style=\"font-size: 18px; font-weight: bold; color: #0F172A; margin-top: 4px;\">{fmt_r0(media_ano_atual)}</div>\n",
        "      </div>\n",
        "    </div>\n",
        "    \"\"\"\n",
        "    display(HTML(cards_html))\n",
        "print(df.columns.tolist())\n",
        "print(\"\\nCat_Letra - distribuição:\")\n",
        "print(df[\"Cat_Letra\"].value_counts())\n",
        "print(\"\\nValor por Cat_Letra (amostra de um mês):\")\n",
        "print(df[df[\"Mes_Competencia\"] == data_corte].groupby(\"Cat_Letra\")[\"Valor\"].sum())"
      ],
      "id": "07657d15",
      "execution_count": null,
      "outputs": []
    }
