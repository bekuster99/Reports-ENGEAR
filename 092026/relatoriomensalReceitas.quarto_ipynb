{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "title: \"Relatório Mensal de Receita\"\n",
        "subtitle: \"Análise Consolidada - Julho de 2026\"\n",
        "format:\n",
        "  html:\n",
        "    page-layout: full\n",
        "    theme: cosmo\n",
        "    toc: false\n",
        "    css: styles.css\n",
        "    embed-resources: true\n",
        "---"
      ],
      "id": "ef6425bb"
    },
    {
      "cell_type": "code",
      "metadata": {
        "message": false
      },
      "source": [
        "#| echo: false\n",
        "#| warning: false\n",
        "\n",
        "import pandas as pd\n",
        "import plotly.express as px\n",
        "import plotly.graph_objects as go\n",
        "from IPython.display import display, HTML\n",
        "\n",
        "#| echo: false\n",
        "#| warning: false\n",
        "#| message: false\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import plotly.graph_objects as go\n",
        "from IPython.display import HTML, display\n",
        "\n",
        "# 1. PARÂMETROS E CARREGAMENTO\n",
        "ANO_ANALISE = 2026\n",
        "MES_ANALISE = 9\n",
        "\n",
        "df = pd.read_excel(\"drgcc.xlsx\")\n",
        "df[\"Competência\"] = pd.to_datetime(df[\"Competência\"])\n",
        "df[\"Valor\"] = pd.to_numeric(df[\"Valor\"], errors=\"coerce\").fillna(0)\n",
        "\n",
        "# Isolamento de Receitas e Normalização das Datas\n",
        "df_receita = df[df[\"Classificação Competencia\"] == \"A - Receitas\"].copy()\n",
        "df_receita[\"Mes_Competencia\"] = (\n",
        "    df_receita[\"Competência\"].dt.to_period(\"M\").dt.to_timestamp()\n",
        ")\n",
        "\n",
        "data_corte = pd.Timestamp(year=ANO_ANALISE, month=MES_ANALISE, day=1)\n",
        "data_mes_anterior = data_corte - pd.DateOffset(months=1)\n",
        "data_ano_anterior = data_corte - pd.DateOffset(years=1)\n",
        "\n",
        "\n",
        "# 2. FUNÇÕES DE FORMATAÇÃO E SUPORTE\n",
        "def fmt_r0(v):\n",
        "  if pd.isna(v) or v == 0:\n",
        "    return \"R$ 0\"\n",
        "  return f\"R$ {v:,.0f}\".replace(\",\", \".\")\n",
        "\n",
        "\n",
        "def fmt_pct(v):\n",
        "  if pd.isna(v) or v == 0:\n",
        "    return \"0,0%\"\n",
        "  sinal = \"+\" if v >= 0 else \"\"\n",
        "  return f\"{sinal}{v:,.1f}%\".replace(\".\", \",\")\n",
        "\n",
        "\n",
        "def classe_card(v):\n",
        "  return \"positivo\" if v >= 0 else \"negativo\"\n",
        "\n",
        "\n",
        "# 3. MÉTRICAS EXECUTIVAS GLOBAIS\n",
        "rec_mes_atual = df_receita[df_receita[\"Mes_Competencia\"] == data_corte][\n",
        "    \"Valor\"\n",
        "].sum()\n",
        "rec_mes_anterior = df_receita[\n",
        "    df_receita[\"Mes_Competencia\"] == data_mes_anterior\n",
        "][\"Valor\"].sum()\n",
        "rec_ano_anterior = df_receita[\n",
        "    df_receita[\"Mes_Competencia\"] == data_ano_anterior\n",
        "][\"Valor\"].sum()\n",
        "\n",
        "df_ano_ate_corte = df_receita[\n",
        "    (df_receita[\"Competência\"].dt.year == ANO_ANALISE)\n",
        "    & (df_receita[\"Mes_Competencia\"] <= data_corte)\n",
        "]\n",
        "media_ano_atual = (\n",
        "    df_ano_ate_corte.groupby(\"Mes_Competencia\")[\"Valor\"].sum().mean()\n",
        ")\n",
        "\n",
        "var_mom = (\n",
        "    ((rec_mes_atual - rec_mes_anterior) / rec_mes_anterior * 100)\n",
        "    if rec_mes_anterior != 0\n",
        "    else 0\n",
        ")\n",
        "var_yoy = (\n",
        "    ((rec_mes_atual - rec_ano_anterior) / rec_ano_anterior * 100)\n",
        "    if rec_ano_anterior != 0\n",
        "    else 0\n",
        ")\n",
        "\n",
        "# Renderização do Dashboard KPI\n",
        "kpi_html = f\"\"\"\n",
        "<div class=\"kpi-grid\">\n",
        "  <div class=\"kpi-card\">\n",
        "    <div class=\"kpi-label\">Receita Total · {MES_ANALISE:02d}/{ANO_ANALISE}</div>\n",
        "    <div class=\"kpi-value\">{fmt_r0(rec_mes_atual)}</div>\n",
        "  </div>\n",
        "  <div class=\"kpi-card\">\n",
        "    <div class=\"kpi-label\">Média Mensal · {ANO_ANALISE}</div>\n",
        "    <div class=\"kpi-value\">{fmt_r0(media_ano_atual)}</div>\n",
        "  </div>\n",
        "  <div class=\"kpi-card {classe_card(var_mom)}\">\n",
        "    <div class=\"kpi-label\">Evolução Mês Anterior</div>\n",
        "    <div class=\"kpi-value\">{fmt_pct(var_mom)}</div>\n",
        "  </div>\n",
        "  <div class=\"kpi-card {classe_card(var_yoy)}\">\n",
        "    <div class=\"kpi-label\">Evolução Ano Anterior</div>\n",
        "    <div class=\"kpi-value\">{fmt_pct(var_yoy)}</div>\n",
        "  </div>\n",
        "</div>\n",
        "\"\"\"\n",
        "display(HTML(kpi_html))\n",
        "\n",
        "# 4. GRÁFICO 1: EVOLUÇÃO HISTÓRICA DA RECEITA TOTAL (EMPILHADO POR MÁSCARA)\n",
        "display(\n",
        "    HTML(\n",
        "        '<h3 class=\"mascara-titulo\" style=\"margin-top:'\n",
        "        ' 40px;\">Evolução Histórica da Receita</h3>'\n",
        "    )\n",
        ")\n",
        "\n",
        "df_historico = df_receita[df_receita[\"Mes_Competencia\"] <= data_corte].copy()\n",
        "\n",
        "df_agrupado = (\n",
        "    df_historico.groupby([\"Mes_Competencia\", \"Máscara\"])[\"Valor\"]\n",
        "    .sum()\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "# Filtra os últimos 6 meses para exibição no gráfico\n",
        "ultimos_meses = df_agrupado[\"Mes_Competencia\"].drop_duplicates().tail(6)\n",
        "df_agrupado = df_agrupado[\n",
        "    df_agrupado[\"Mes_Competencia\"].isin(ultimos_meses)\n",
        "].copy()\n",
        "\n",
        "df_pivot = df_agrupado.pivot(\n",
        "    index=\"Mes_Competencia\", columns=\"Máscara\", values=\"Valor\"\n",
        ").fillna(0)\n",
        "labels_mes = df_pivot.index.strftime(\"%b/%Y\")\n",
        "\n",
        "paleta_cores = [\n",
        "    \"#1B2A4A\",\n",
        "    \"#2C4470\",\n",
        "    \"#3D5C96\",\n",
        "    \"#5978B4\",\n",
        "    \"#7B97C9\",\n",
        "    \"#A0B4DC\",\n",
        "    \"#C5D3ED\",\n",
        "]\n",
        "\n",
        "fig_receita = go.Figure()\n",
        "\n",
        "for i, mascara in enumerate(df_pivot.columns):\n",
        "  valores = df_pivot[mascara]\n",
        "  cor = paleta_cores[i % len(paleta_cores)]\n",
        "  textos = [fmt_r0(v) if v > 0 else \"\" for v in valores]\n",
        "\n",
        "  fig_receita.add_trace(\n",
        "      go.Bar(\n",
        "          name=mascara,\n",
        "          x=labels_mes,\n",
        "          y=valores,\n",
        "          text=textos,\n",
        "          textposition=\"inside\",\n",
        "          insidetextanchor=\"middle\",\n",
        "          textfont=dict(color=\"white\", size=11),\n",
        "          marker_color=cor,\n",
        "          marker_line_width=0,\n",
        "          hovertemplate=(\n",
        "              f\"<b>{mascara}</b><br>%{{x}}: R$ %{{y:,.2f}}<extra></extra>\"\n",
        "          ),\n",
        "      )\n",
        "  )\n",
        "\n",
        "totais_mensais = df_pivot.sum(axis=1)\n",
        "\n",
        "fig_receita.update_layout(\n",
        "    barmode=\"stack\",\n",
        "    yaxis_title=\"Receita Total (R$)\",\n",
        "    xaxis_title=None,\n",
        "    showlegend=True,\n",
        "    legend=dict(\n",
        "        orientation=\"h\", yanchor=\"bottom\", y=1.02, xanchor=\"right\", x=1\n",
        "    ),\n",
        "    template=\"plotly_white\",\n",
        "    font=dict(family=\"Segoe UI, Arial\", size=13, color=\"#1E293B\"),\n",
        "    margin=dict(t=60, b=20),\n",
        "    plot_bgcolor=\"white\",\n",
        "    height=450,\n",
        ")\n",
        "\n",
        "for x_val, y_val in zip(labels_mes, totais_mensais):\n",
        "  if y_val > 0:\n",
        "    fig_receita.add_annotation(\n",
        "        x=x_val,\n",
        "        y=y_val,\n",
        "        text=f\"<b>{fmt_r0(y_val)}</b>\",\n",
        "        showarrow=False,\n",
        "        yshift=12,\n",
        "        font=dict(family=\"Segoe UI, Arial\", size=11, color=\"#1E293B\"),\n",
        "    )\n",
        "\n",
        "fig_receita.show()\n",
        "\n",
        "# 5. MAPEAMENTO E GRÁFICOS DOS PILARES (OBRAS E MANUTENÇÃO)\n",
        "display(\n",
        "    HTML(\n",
        "        '<h2 style=\"margin-top: 50px; border-bottom: 2px solid #E2E8F0;'\n",
        "        ' padding-bottom: 8px;\">Receita por Serviço</h2>'\n",
        "    )\n",
        ")\n",
        "\n",
        "condicoes = [\n",
        "    df_receita[\"Tipo Serviço\"]\n",
        "    .astype(str)\n",
        "    .str.upper()\n",
        "    .str.contains(\"MANUT\", na=False),\n",
        "    df_receita[\"Tipo Serviço\"]\n",
        "    .astype(str)\n",
        "    .str.upper()\n",
        "    .str.contains(\"OBRA|FABRIC|PROJETO\", na=False),\n",
        "]\n",
        "escolhas = [\"Manutenção\", \"Obras\"]\n",
        "df_receita[\"Tipo_Servico_Agrupado\"] = np.select(\n",
        "    condicoes, escolhas, default=\"Outros\"\n",
        ")\n",
        "\n",
        "config_graficos = [\n",
        "    (\"Obras\", \"#1B2A4A\", \"Evolução da Receita · Obras (Últimos 12 Meses)\"),\n",
        "    (\n",
        "        \"Manutenção\",\n",
        "        \"#C0392B\",\n",
        "        \"Evolução da Receita · Manutenção (Últimos 12 Meses)\",\n",
        "    ),\n",
        "]\n",
        "\n",
        "for pilar, cor_barra, titulo in config_graficos:\n",
        "  display(\n",
        "      HTML(f'<h3 class=\"mascara-titulo\" style=\"margin-top: 40px;\">{titulo}</h3>')\n",
        "  )\n",
        "\n",
        "  df_pilar = df_receita[df_receita[\"Tipo_Servico_Agrupado\"] == pilar].copy()\n",
        "\n",
        "  if df_pilar.empty:\n",
        "    display(\n",
        "        HTML(\n",
        "            '<p class=\"sem-dados\">Nenhum lançamento registrado para este'\n",
        "            ' segmento no período.</p>'\n",
        "        )\n",
        "    )\n",
        "    continue\n",
        "\n",
        "  df_historico_pilar = df_pilar[\n",
        "      df_pilar[\"Mes_Competencia\"] <= data_corte\n",
        "  ].copy()\n",
        "  df_mensal_pilar = (\n",
        "      df_historico_pilar.groupby(\"Mes_Competencia\", as_index=False)[\"Valor\"]\n",
        "      .sum()\n",
        "      .sort_values(\"Mes_Competencia\")\n",
        "  )\n",
        "  df_mensal_pilar = df_mensal_pilar.tail(12).copy()\n",
        "\n",
        "  labels_mes = df_mensal_pilar[\"Mes_Competencia\"].dt.strftime(\"%b/%Y\")\n",
        "  valores = df_mensal_pilar[\"Valor\"]\n",
        "  textos = [fmt_r0(v) if v > 0 else \"\" for v in valores]\n",
        "\n",
        "  fig = go.Figure()\n",
        "  fig.add_trace(\n",
        "      go.Bar(\n",
        "          x=labels_mes,\n",
        "          y=valores,\n",
        "          text=textos,\n",
        "          textposition=\"inside\",\n",
        "          insidetextanchor=\"middle\",\n",
        "          textfont=dict(color=\"white\", size=11),\n",
        "          marker_color=cor_barra,\n",
        "          hovertemplate=f\"<b>{pilar}</b><br>%{{x}}: R$ %{{y:,.2f}}<extra></extra>\",\n",
        "      )\n",
        "  )\n",
        "\n",
        "  fig.update_layout(\n",
        "      yaxis_title=\"Receita (R$)\",\n",
        "      xaxis_title=None,\n",
        "      showlegend=False,\n",
        "      template=\"plotly_white\",\n",
        "      font=dict(family=\"Segoe UI, Arial\", size=12, color=\"#1E293B\"),\n",
        "      margin=dict(t=30, b=20),\n",
        "      plot_bgcolor=\"white\",\n",
        "      height=360,\n",
        "  )\n",
        "  fig.show()\n",
        "\n",
        "  rec_atual_pilar = df_pilar[df_pilar[\"Mes_Competencia\"] == data_corte][\n",
        "      \"Valor\"\n",
        "  ].sum()\n",
        "  rec_anterior_pilar = df_pilar[\n",
        "      df_pilar[\"Mes_Competencia\"] == data_mes_anterior\n",
        "  ][\"Valor\"].sum()\n",
        "  rec_ano_ant_pilar = df_pilar[\n",
        "      df_pilar[\"Mes_Competencia\"] == data_ano_anterior\n",
        "  ][\"Valor\"].sum()\n",
        "\n",
        "  df_pilar_ano = df_pilar[\n",
        "      (df_pilar[\"Competência\"].dt.year == ANO_ANALISE)\n",
        "      & (df_pilar[\"Mes_Competencia\"] <= data_corte)\n",
        "  ]\n",
        "  media_ano_pilar = (\n",
        "      df_pilar_ano.groupby(\"Mes_Competencia\")[\"Valor\"].sum().mean()\n",
        "  )\n",
        "\n",
        "  var_mom_pilar = (\n",
        "      ((rec_atual_pilar - rec_anterior_pilar) / rec_anterior_pilar * 100)\n",
        "      if rec_anterior_pilar != 0\n",
        "      else 0\n",
        "  )\n",
        "  var_yoy_pilar = (\n",
        "      ((rec_atual_pilar - rec_ano_ant_pilar) / rec_ano_ant_pilar * 100)\n",
        "      if rec_ano_ant_pilar != 0\n",
        "      else 0\n",
        "  )\n",
        "\n",
        "  kpi_pilar_html = f\"\"\"\n",
        "    <div class=\"kpi-grid\" style=\"margin-bottom: 30px;\">\n",
        "      <div class=\"kpi-card\">\n",
        "        <div class=\"kpi-label\">Receita {pilar} · {MES_ANALISE:02d}/{ANO_ANALISE}</div>\n",
        "        <div class=\"kpi-value\">{fmt_r0(rec_atual_pilar)}</div>\n",
        "      </div>\n",
        "      <div class=\"kpi-card\">\n",
        "        <div class=\"kpi-label\">Média Mensal · {ANO_ANALISE}</div>\n",
        "        <div class=\"kpi-value\">{fmt_r0(media_ano_pilar if pd.notna(media_ano_pilar) else 0)}</div>\n",
        "      </div>\n",
        "      <div class=\"kpi-card {classe_card(var_mom_pilar)}\">\n",
        "        <div class=\"kpi-label\">Evolução Mês Anterior</div>\n",
        "        <div class=\"kpi-value\">{fmt_pct(var_mom_pilar)}</div>\n",
        "      </div>\n",
        "      <div class=\"kpi-card {classe_card(var_yoy_pilar)}\">\n",
        "        <div class=\"kpi-label\">Evolução Ano Anterior</div>\n",
        "        <div class=\"kpi-value\">{fmt_pct(var_yoy_pilar)}</div>\n",
        "      </div>\n",
        "    </div>\n",
        "    \"\"\"\n",
        "  display(HTML(kpi_pilar_html))"
      ],
      "id": "5e8c693b",
      "execution_count": null,
      "outputs": []
    }
  ],
