{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "title: \"Relatório Operacional D2\"\n",
        "subtitle: \"Análise Consolidada de Despesas / Custos\"\n",
        "format:\n",
        "  html:\n",
        "    page-layout: full\n",
        "    theme: cosmo\n",
        "    toc: false\n",
        "    css: styles.css\n",
        "    embed-resources: true\n",
        "---"
      ],
      "id": "1d7149ab"
    },
    {
      "cell_type": "code",
      "metadata": {
        "message": false
      },
      "source": [
        "#| echo: false\n",
        "#| warning: false\n",
        "#| output: asis\n",
        "\n",
        "import pandas as pd\n",
        "import plotly.graph_objects as go\n",
        "from IPython.display import display, HTML\n",
        "\n",
        "# -------------------------------------------------------------------------\n",
        "# 1. PARÂMETROS E FILTRO CENTRAL\n",
        "# -------------------------------------------------------------------------\n",
        "ANO_ANALISE = 2026\n",
        "MES_ANALISE = 9\n",
        "\n",
        "# ALVO DA ANÁLISE: Altere esta string para replicar a página para qualquer classe (ex: \"C1\", \"D\", \"E\")\n",
        "CLASSIFICACAO_ALVO = \"D2\"\n",
        "\n",
        "# Carregamento e Preparação dos Dados\n",
        "df = pd.read_excel(\"drgcc.xlsx\")\n",
        "df[\"Competência\"] = pd.to_datetime(df[\"Competência\"])\n",
        "df[\"Valor\"] = pd.to_numeric(df[\"Valor\"], errors=\"coerce\").fillna(0)\n",
        "df[\"Valor_Abs\"] = df[\"Valor\"].abs()\n",
        "df[\"Mes_Competencia\"] = df[\"Competência\"].dt.to_period(\"M\").dt.to_timestamp()\n",
        "\n",
        "# Identificação da classe exata na base que inicia com o código alvo\n",
        "classes_existentes = df[\"Classificação Competencia\"].dropna().unique()\n",
        "classe_encontrada = next((c for c in classes_existentes if c.startswith(CLASSIFICACAO_ALVO)), CLASSIFICACAO_ALVO)\n",
        "\n",
        "# Datas de Corte\n",
        "data_corte = pd.Timestamp(year=ANO_ANALISE, month=MES_ANALISE, day=1)\n",
        "data_ano_anterior = data_corte - pd.DateOffset(years=1)\n",
        "inicio_13m = data_corte - pd.DateOffset(months=12)\n",
        "\n",
        "# Funções de Formatação\n",
        "def fmt_r0(v):\n",
        "    return f\"R$ {v:,.0f}\".replace(\",\", \".\")\n",
        "\n",
        "def fmt_pct(v):\n",
        "    if pd.isna(v) or v == 0:\n",
        "        return \"0,0%\"\n",
        "    sinal = \"+\" if v >= 0 else \"\"\n",
        "    return f\"{sinal}{v:,.1f}%\".replace(\".\", \",\")\n",
        "\n",
        "def classe_card(valor):\n",
        "    return \"positivo\" if valor <= 0 else \"negativo\" # Para despesas, redução é positivo\n",
        "\n",
        "# -------------------------------------------------------------------------\n",
        "# 2. CÁLCULOS DOS INDICADORES (KPIS)\n",
        "# -------------------------------------------------------------------------\n",
        "# Baselines de Receita (Dividendo para Análise Vertical)\n",
        "rec_mes_atual = df[\n",
        "    (df[\"Classificação Competencia\"] == \"A - Receitas\") & \n",
        "    (df[\"Mes_Competencia\"] == data_corte)\n",
        "][\"Valor_Abs\"].sum()\n",
        "\n",
        "rec_total_ano = df[\n",
        "    (df[\"Classificação Competencia\"] == \"A - Receitas\") & \n",
        "    (df[\"Mes_Competencia\"].dt.year == ANO_ANALISE)\n",
        "][\"Valor_Abs\"].sum()\n",
        "\n",
        "# Base da Classificação Alvo\n",
        "df_alvo = df[df[\"Classificação Competencia\"] == classe_encontrada].copy()\n",
        "\n",
        "# A) Valor no Mês\n",
        "val_mes_atual = df_alvo[df_alvo[\"Mes_Competencia\"] == data_corte][\"Valor_Abs\"].sum()\n",
        "\n",
        "# B) Média do Ano\n",
        "media_ano = (\n",
        "    df_alvo[df_alvo[\"Mes_Competencia\"].dt.year == ANO_ANALISE]\n",
        "    .groupby(\"Mes_Competencia\")[\"Valor_Abs\"]\n",
        "    .sum()\n",
        "    .mean()\n",
        ")\n",
        "media_ano = media_ano if pd.notna(media_ano) else 0\n",
        "\n",
        "# C) Variação Ano Anterior (YoY Mês)\n",
        "val_ano_anterior = df_alvo[df_alvo[\"Mes_Competencia\"] == data_ano_anterior][\"Valor_Abs\"].sum()\n",
        "var_yoy = ((val_mes_atual - val_ano_anterior) / val_ano_anterior * 100) if val_ano_anterior > 0 else 0\n",
        "\n",
        "# D) Análise Vertical do Mês (% Receita do Mês)\n",
        "av_mes = (val_mes_atual / rec_mes_atual * 100) if rec_mes_atual > 0 else 0\n",
        "\n",
        "# E) Análise Vertical do Ano (% Receita do Ano)\n",
        "val_acum_ano = df_alvo[df_alvo[\"Mes_Competencia\"].dt.year == ANO_ANALISE][\"Valor_Abs\"].sum()\n",
        "av_ano = (val_acum_ano / rec_total_ano * 100) if rec_total_ano > 0 else 0\n",
        "\n",
        "# -------------------------------------------------------------------------\n",
        "# 3. RENDERIZAÇÃO DOS KPIS\n",
        "# -------------------------------------------------------------------------\n",
        "display(HTML(f'<h2 style=\"margin-top: 10px; color: #0F172A;\">Classificação: {classe_encontrada}</h2>'))\n",
        "\n",
        "kpis_html = f\"\"\"\n",
        "<div class=\"kpi-grid\" style=\"display: grid; grid-template-columns: repeat(5, 1fr); gap: 15px; margin-top: 20px; margin-bottom: 30px;\">\n",
        "  <div class=\"kpi-card\" style=\"background: #F8FAFC; padding: 15px; border-radius: 8px; border: 1px solid #E2E8F0;\">\n",
        "    <div class=\"kpi-label\" style=\"font-size: 11px; color: #64748B;\">Valor no Mês ({MES_ANALISE:02d}/{ANO_ANALISE})</div>\n",
        "    <div class=\"kpi-value\" style=\"font-size: 18px; font-weight: bold; color: #0F172A;\">{fmt_r0(val_mes_atual)}</div>\n",
        "  </div>\n",
        "  <div class=\"kpi-card\" style=\"background: #F8FAFC; padding: 15px; border-radius: 8px; border: 1px solid #E2E8F0;\">\n",
        "    <div class=\"kpi-label\" style=\"font-size: 11px; color: #64748B;\">Média Mensal ({ANO_ANALISE})</div>\n",
        "    <div class=\"kpi-value\" style=\"font-size: 18px; font-weight: bold; color: #0F172A;\">{fmt_r0(media_ano)}</div>\n",
        "  </div>\n",
        "  <div class=\"kpi-card\" style=\"background: #F8FAFC; padding: 15px; border-radius: 8px; border: 1px solid #E2E8F0;\">\n",
        "    <div class=\"kpi-label\" style=\"font-size: 11px; color: #64748B;\">Evolução Ano Anterior</div>\n",
        "    <div class=\"kpi-value\" style=\"font-size: 18px; font-weight: bold; color: #0F172A;\">{fmt_pct(var_yoy)}</div>\n",
        "  </div>\n",
        "  <div class=\"kpi-card\" style=\"background: #F8FAFC; padding: 15px; border-radius: 8px; border: 1px solid #E2E8F0;\">\n",
        "    <div class=\"kpi-label\" style=\"font-size: 11px; color: #64748B;\">AV do Mês (% Rec.)</div>\n",
        "    <div class=\"kpi-value\" style=\"font-size: 18px; font-weight: bold; color: #0F172A;\">{av_mes:.1f}%</div>\n",
        "  </div>\n",
        "  <div class=\"kpi-card\" style=\"background: #F8FAFC; padding: 15px; border-radius: 8px; border: 1px solid #E2E8F0;\">\n",
        "    <div class=\"kpi-label\" style=\"font-size: 11px; color: #64748B;\">AV do Ano (% Rec.)</div>\n",
        "    <div class=\"kpi-value\" style=\"font-size: 18px; font-weight: bold; color: #0F172A;\">{av_ano:.1f}%</div>\n",
        "  </div>\n",
        "</div>\n",
        "\"\"\"\n",
        "display(HTML(kpis_html))\n",
        "\n",
        "# -------------------------------------------------------------------------\n",
        "# 4. GRÁFICO DE BARRAS: ÚLTIMOS 13 MESES\n",
        "# -------------------------------------------------------------------------\n",
        "df_13m = (\n",
        "    df_alvo[(df_alvo[\"Mes_Competencia\"] >= inicio_13m) & (df_alvo[\"Mes_Competencia\"] <= data_corte)]\n",
        "    .groupby(\"Mes_Competencia\", as_index=False)[\"Valor_Abs\"]\n",
        "    .sum()\n",
        "    .sort_values(\"Mes_Competencia\")\n",
        ")\n",
        "\n",
        "labels_13m = df_13m[\"Mes_Competencia\"].dt.strftime(\"%b/%Y\")\n",
        "valores_13m = df_13m[\"Valor_Abs\"]\n",
        "\n",
        "fig_13m = go.Figure()\n",
        "fig_13m.add_trace(go.Bar(\n",
        "    x=labels_13m,\n",
        "    y=valores_13m,\n",
        "    text=[fmt_r0(v) for v in valores_13m],\n",
        "    textposition=\"outside\",\n",
        "    textfont=dict(family=\"Segoe UI, Arial\", size=10, color=\"#334155\"),\n",
        "    marker_color=\"#334155\",\n",
        "    hovertemplate=\"<b>Total Mês</b><br>%{x}: R$ %{y:,.2f}<extra></extra>\"\n",
        "))\n",
        "\n",
        "fig_13m.update_layout(\n",
        "    title=dict(text=\"Evolução Mensal (Últimos 13 Meses)\", font=dict(size=14)),\n",
        "    yaxis_title=\"R$\",\n",
        "    xaxis_title=None,\n",
        "    template=\"plotly_white\",\n",
        "    font=dict(family=\"Segoe UI, Arial\", size=11, color=\"#1E293B\"),\n",
        "    margin=dict(t=40, b=20),\n",
        "    height=360\n",
        ")\n",
        "fig_13m.show()\n",
        "\n",
        "# -------------------------------------------------------------------------\n",
        "# 5. TABELA CONSOLIDADA DE MÁSCARAS (MÊS DE ANÁLISE)\n",
        "# -------------------------------------------------------------------------\n",
        "display(HTML('<h3 style=\"margin-top: 35px; color: #0F172A;\">Detalhamento por Máscara no Mês</h3>'))\n",
        "\n",
        "df_masc_mes = (\n",
        "    df_alvo[df_alvo[\"Mes_Competencia\"] == data_corte]\n",
        "    .groupby(\"Máscara\", as_index=False)[\"Valor_Abs\"]\n",
        "    .sum()\n",
        "    .sort_values(\"Valor_Abs\", ascending=False)\n",
        ")\n",
        "df_masc_mes[\"AV_Masc\"] = (df_masc_mes[\"Valor_Abs\"] / rec_mes_atual * 100) if rec_mes_atual > 0 else 0\n",
        "\n",
        "rows_masc = \"\"\n",
        "for _, r in df_masc_mes.iterrows():\n",
        "    rows_masc += f\"\"\"\n",
        "    <tr>\n",
        "        <td style=\"padding: 8px 10px; border-bottom: 1px solid #E2E8F0;\">{r['Máscara']}</td>\n",
        "        <td style=\"padding: 8px 10px; border-bottom: 1px solid #E2E8F0; text-align: right;\">{fmt_r0(r['Valor_Abs'])}</td>\n",
        "        <td style=\"padding: 8px 10px; border-bottom: 1px solid #E2E8F0; text-align: right;\">{r['AV_Masc']:.2f}%</td>\n",
        "    </tr>\n",
        "    \"\"\"\n",
        "\n",
        "tbl_masc_html = f\"\"\"\n",
        "<table style=\"width: 100%; border-collapse: collapse; margin-top: 10px; font-family: 'Segoe UI', Arial;\">\n",
        "    <thead>\n",
        "        <tr style=\"background-color: #F8FAFC; border-bottom: 2px solid #E2E8F0; text-align: left;\">\n",
        "            <th style=\"padding: 10px;\">Máscara</th>\n",
        "            <th style=\"padding: 10px; text-align: right;\">Valor no Mês</th>\n",
        "            <th style=\"padding: 10px; text-align: right;\">Análise Vertical (% Rec. Mês)</th>\n",
        "        </tr>\n",
        "    </thead>\n",
        "    <tbody>\n",
        "        {rows_masc}\n",
        "        <tr style=\"font-weight: bold; background-color: #F1F5F9; border-top: 2px solid #CBD5E1;\">\n",
        "            <td style=\"padding: 10px;\">TOTAL DA CLASSIFICAÇÃO</td>\n",
        "            <td style=\"padding: 10px; text-align: right;\">{fmt_r0(val_mes_atual)}</td>\n",
        "            <td style=\"padding: 10px; text-align: right;\">{av_mes:.2f}%</td>\n",
        "        </tr>\n",
        "    </tbody>\n",
        "</table>\n",
        "\"\"\"\n",
        "display(HTML(tbl_masc_html))\n",
        "\n",
        "# -------------------------------------------------------------------------\n",
        "# 6. TABELAS DE MAIORES VARIAÇÕES (MÊS ATUAL VS. MÊS ANTERIOR)\n",
        "# -------------------------------------------------------------------------\n",
        "mes_anterior = data_corte - pd.DateOffset(months=1)\n",
        "\n",
        "# Agrupamento Mês Atual e Mês Anterior por Máscara\n",
        "df_var_comp = (\n",
        "    df_alvo[df_alvo[\"Mes_Competencia\"].isin([data_corte, mes_anterior])]\n",
        "    .groupby([\"Máscara\", \"Mes_Competencia\"])[\"Valor_Abs\"]\n",
        "    .sum()\n",
        "    .unstack(fill_value=0)\n",
        ")\n",
        "\n",
        "# Garantir existência das colunas\n",
        "if data_corte not in df_var_comp.columns: df_var_comp[data_corte] = 0\n",
        "if mes_anterior not in df_var_comp.columns: df_var_comp[mes_anterior] = 0\n",
        "\n",
        "df_var_comp[\"Var_R$\"] = df_var_comp[data_corte] - df_var_comp[mes_anterior]\n",
        "df_var_comp[\"Var_%\"] = (df_var_comp[\"Var_R$\"] / df_var_comp[mes_anterior] * 100).fillna(0)\n",
        "\n",
        "# Top 5 Variação Monetária (Absoluta)\n",
        "top5_abs = df_var_comp.reindex(df_var_comp[\"Var_R$\"].abs().sort_values(ascending=False).index).head(5)\n",
        "\n",
        "# Top 5 Variação Percentual (Considerando base relevante para evitar divisão por zero/ruído)\n",
        "top5_pct = df_var_comp[df_var_comp[mes_anterior] > 0].sort_values(\"Var_%\", ascending=False).head(5)\n",
        "\n",
        "# HTML Tabela Variação Monetária\n",
        "rows_abs = \"\"\n",
        "for masc, r in top5_abs.iterrows():\n",
        "    color_var = \"#15803D\" if r[\"Var_R$\"] <= 0 else \"#B91C1C\"\n",
        "    rows_abs += f\"\"\"\n",
        "    <tr>\n",
        "        <td style=\"padding: 8px 10px; border-bottom: 1px solid #E2E8F0;\">{masc}</td>\n",
        "        <td style=\"padding: 8px 10px; border-bottom: 1px solid #E2E8F0; text-align: right;\">{fmt_r0(r[mes_anterior])}</td>\n",
        "        <td style=\"padding: 8px 10px; border-bottom: 1px solid #E2E8F0; text-align: right;\">{fmt_r0(r[data_corte])}</td>\n",
        "        <td style=\"padding: 8px 10px; border-bottom: 1px solid #E2E8F0; text-align: right; color: {color_var}; font-weight: bold;\">{fmt_r0(r['Var_R$'])}</td>\n",
        "    </tr>\n",
        "    \"\"\"\n",
        "\n",
        "# HTML Tabela Variação Percentual\n",
        "rows_pct = \"\"\n",
        "for masc, r in top5_pct.iterrows():\n",
        "    color_var = \"#15803D\" if r[\"Var_%\"] <= 0 else \"#B91C1C\"\n",
        "    rows_pct += f\"\"\"\n",
        "    <tr>\n",
        "        <td style=\"padding: 8px 10px; border-bottom: 1px solid #E2E8F0;\">{masc}</td>\n",
        "        <td style=\"padding: 8px 10px; border-bottom: 1px solid #E2E8F0; text-align: right;\">{fmt_r0(r[mes_anterior])}</td>\n",
        "        <td style=\"padding: 8px 10px; border-bottom: 1px solid #E2E8F0; text-align: right;\">{fmt_r0(r[data_corte])}</td>\n",
        "        <td style=\"padding: 8px 10px; border-bottom: 1px solid #E2E8F0; text-align: right; color: {color_var}; font-weight: bold;\">{fmt_pct(r['Var_%'])}</td>\n",
        "    </tr>\n",
        "    \"\"\"\n",
        "\n",
        "tables_var_html = f\"\"\"\n",
        "<div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 35px; font-family: 'Segoe UI', Arial;\">\n",
        "    <div>\n",
        "        <h4 style=\"color: #0F172A; margin-bottom: 10px;\">Top 5 Maiores Variações (R$) vs. Mês Anterior</h4>\n",
        "        <table style=\"width: 100%; border-collapse: collapse;\">\n",
        "            <thead>\n",
        "                <tr style=\"background-color: #F8FAFC; border-bottom: 2px solid #E2E8F0; text-align: left;\">\n",
        "                    <th style=\"padding: 8px;\">Máscara</th>\n",
        "                    <th style=\"padding: 8px; text-align: right;\">Mês Ant.</th>\n",
        "                    <th style=\"padding: 8px; text-align: right;\">Mês Atual</th>\n",
        "                    <th style=\"padding: 8px; text-align: right;\">Var R$</th>\n",
        "                </tr>\n",
        "            </thead>\n",
        "            <tbody>{rows_abs}</tbody>\n",
        "        </table>\n",
        "    </div>\n",
        "    <div>\n",
        "        <h4 style=\"color: #0F172A; margin-bottom: 10px;\">Top 5 Maiores Variações (%) vs. Mês Anterior</h4>\n",
        "        <table style=\"width: 100%; border-collapse: collapse;\">\n",
        "            <thead>\n",
        "                <tr style=\"background-color: #F8FAFC; border-bottom: 2px solid #E2E8F0; text-align: left;\">\n",
        "                    <th style=\"padding: 8px;\">Máscara</th>\n",
        "                    <th style=\"padding: 8px; text-align: right;\">Mês Ant.</th>\n",
        "                    <th style=\"padding: 8px; text-align: right;\">Mês Atual</th>\n",
        "                    <th style=\"padding: 8px; text-align: right;\">Var %</th>\n",
        "                </tr>\n",
        "            </thead>\n",
        "            <tbody>{rows_pct}</tbody>\n",
        "        </table>\n",
        "    </div>\n",
        "</div>\n",
        "\"\"\"\n",
        "display(HTML(tables_var_html))"
      ],
      "id": "0968a2bd",
      "execution_count": null,
      "outputs": []
    }
  ],
